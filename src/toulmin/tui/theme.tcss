/* Quiet pixel-terminal palette. Text and labels carry every status meaning. */
Screen {
    background: #101922;
    color: #e5dfcb;
}
Screen > #brand {
    height: 3;
    padding: 1 2 0 2;
    color: #72e1df;
    text-style: bold;
    background: #192936;
}
Footer {
    background: #192936;
    color: #c1c9c2;
}
Button {
    background: #253746;
    border: tall #395364;
    color: #e5dfcb;
    min-width: 10;
}
Button.-primary {
    background: #19464b;
    border: tall #72e1df;
    color: #e7f6e9;
}
Button:focus, Input:focus, TextArea:focus, Select:focus {
    border: tall #72e1df;
}
Input, TextArea {
    background: #15232e;
    border: tall #395364;
    color: #e5dfcb;
}
TextArea {
    min-height: 5;
}
Label { color: #e5dfcb; }
.muted { color: #a2b1b8; height: auto; }
.error { color: #ff9791; height: auto; margin: 0 1; }
.page-title { color: #e6bd76; text-style: bold; margin: 0 0 1 0; }
.panel-title {
    height: 2;
    color: #e6bd76;
    text-style: bold;
    padding: 0 1;
}
.actions {
    height: 3;
    margin: 0 1;
    align-horizontal: left;
}
.actions Button { margin-right: 1; }
#home-scroll { height: 1fr; align: center middle; }
#home-card {
    width: 66;
    max-width: 100%;
    height: auto;
    padding: 1 3;
    border: double #395364;
}
#wordmark { color: #72e1df; text-style: bold; height: 4; }
#tagline { height: auto; margin-bottom: 1; }
#home-card Button { width: 100%; margin-bottom: 1; }
#home-root { height: 1; color: #a2b1b8; padding: 0 2; }
#setup-form { padding: 1 3; height: 1fr; }
#setup-form > Label { height: auto; margin-top: 1; }
#setup-goal { height: 6; }
#setup-motivation { height: 8; }
#import-controls { height: 3; }
#import-controls Input { width: 1fr; }
#import-controls Button { margin-left: 1; }
#import-status { margin-top: 1; }
#open-root-row { height: 3; margin: 1 2; }
#open-root-row Input { width: 1fr; margin-right: 1; }
#open-content { height: 1fr; margin: 1 2; }
#project-list-pane { width: 30%; min-width: 18; border: round #395364; }
#project-list { height: 1fr; background: #15232e; }
#project-preview-pane { width: 1fr; border: round #395364; padding: 0 1; }
ListView { background: #15232e; }
ListItem { padding: 0 1; }
ListItem.--highlight { background: #24535a; color: #eff9e5; }
#workspace-status { height: 1; padding: 0 2; color: #e6bd76; }
#workspace-toolbar { height: 3; padding: 0 1; }
#workspace-home { width: 10; margin-right: 1; }
#step-select { width: 1fr; }
#toggle-inspector { width: 17; margin-left: 1; }
#resize-notice { display: none; height: auto; color: #e6bd76; padding: 0 1; }
#workspace-body { height: 1fr; padding: 0 1; }
#navigation { width: 18; margin-right: 1; border: solid #395364; }
#step-list { height: 1fr; }
#nav-note { padding: 1; }
.pane { border: solid #395364; }
#main-pane { width: 1fr; }
#main-scroll, #inspector-scroll { height: 1fr; }
#inspector { width: 37%; margin-left: 1; display: none; }
.inspector-visible #inspector { display: block; }
#main-content, #brief-content { margin: 0 1; }
#project-path { margin: 1; }
#resume-setup { margin: 1; }
.medium #inspector { width: 1fr; }
.medium.inspector-visible #main-pane { display: none; }
.compact #navigation { display: none; }
.compact #resize-notice { display: block; }
.compact #workspace-body { padding: 0; }
.compact #inspector { width: 1fr; margin-left: 0; }
.compact.inspector-visible #main-pane { display: none; }
ModalScreen { align: center middle; background: #060d14 75%; }
.dialog {
    width: 85%;
    max-width: 100;
    height: 85%;
    border: double #72e1df;
    background: #192936;
    padding: 1 2;
}
.small-dialog { height: auto; max-height: 95%; max-width: 68; }
.dialog-title { color: #e6bd76; text-style: bold; height: auto; margin-bottom: 1; }
.dialog Static { height: auto; margin-bottom: 1; }
#import-preview { height: 1fr; margin: 1 0; }
#file-tree { height: 1fr; background: #15232e; }
#quit-actions { height: auto; }
#quit-actions Button { width: 100%; }
HelpScreen .small-dialog { height: 85%; }
.ascii #home-card, .ascii .pane, .ascii #navigation,
.ascii #project-list-pane, .ascii #project-preview-pane {
    border: ascii #395364;
}
.ascii .dialog, .ascii Input:focus, .ascii TextArea:focus, .ascii Select:focus,
.ascii Button:focus {
    border: ascii #72e1df;
}

/* Conversation stays primary; compact mode retains every model action. */
.workspace-screen > #brand { height: 1; padding: 0 1; }
.workspace-screen #workspace-status { padding: 0 1; }
.workspace-screen .panel-title { height: 1; }
.workspace-screen #navigation { width: 23; }
#research-scroll { height: 1fr; }
#research-state { margin: 0 1; }
.workspace-screen #step-list { height: 7; }
#transcript { margin: 0 1; }
#discussion-status { height: 1; padding: 0 1; color: #a2b1b8; }
#composer { height: 5; min-height: 3; margin: 0 1; }
#discussion-controls { height: 3; padding: 0 1; }
#discussion-controls Button { min-width: 6; width: auto; margin-left: 1; }
#discussion-model { width: 1fr; min-width: 10; }
#brief-tab { height: 3; }
#proposal-editor { min-height: 8; height: 1fr; }
#proposal-state { height: auto; margin: 0 1; }
#brief-changes { margin: 0 1; }
#proposal-actions { height: 3; }
#proposal-actions Button { min-width: 8; width: 1fr; }
.compact #composer { height: 3; margin: 0; }
.compact #discussion-controls { height: 2; layout: grid; grid-size: 4 2; grid-columns: 1fr 1fr 1fr 1fr; grid-rows: 1 1; padding: 0; }
.compact #discussion-model { column-span: 2; width: 100%; height: 1; }
.compact #discussion-controls Button { margin: 0; width: 100%; height: 1; min-height: 1; border: none; padding: 0 1; }
.compact #discussion-status { height: 1; }
.compact #workspace-toolbar { height: 1; padding: 0; }
.compact #workspace-toolbar Button, .compact #workspace-toolbar Select { height: 1; border: none; }
.compact #workspace-home { width: 7; margin: 0; }
.compact #toggle-inspector { width: 14; margin: 0; }
.compact #resize-notice { display: none; }
.compact #brief-tab { height: 1; }
.compact #proposal-actions { height: 1; }
.compact #proposal-actions Button { height: 1; min-height: 1; border: none; padding: 0 1; }
.compact #proposal-editor { min-height: 5; height: 1fr; border: none; }
.medium #navigation { display: none; }
